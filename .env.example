# Copy to .env.local for local commands, or .env for Docker Compose.
DATABASE_URL=postgresql://appgrade:CHANGE_ME@localhost:5432/appgrade
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Two different tokens from @BotFather. Never use NEXT_PUBLIC_ for secrets.
TELEGRAM_PRICE_BOT_TOKEN=
TELEGRAM_PRICE_ADMIN_IDS=
TELEGRAM_ORDERS_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=
PRICE_UPLOAD_DIR=var/price-uploads

# Docker Compose: use a long random alphanumeric password.
POSTGRES_PASSWORD=

# Public deployment and seller details (never invent seller records).
SITE_DOMAIN=
SELLER_NAME=
SELLER_INN=
SELLER_ADDRESS=
SELLER_PRIVACY_EMAIL=
ADMIN_USER=admin
# At least 20 characters. Never prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD=
# Enable only behind the supplied proxy, which overwrites X-Real-IP.
TRUST_PROXY=false
BACKUP_DIR=./var/backups
NEXT_PUBLIC_SIBAY_ADDRESS=
NEXT_PUBLIC_SIBAY_PHONE=
NEXT_PUBLIC_SIBAY_SCHEDULE=
